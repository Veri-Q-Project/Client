# Local Node captcha verify server port
CAPTCHA_SERVER_PORT=8080

# Allowed frontend origin for CORS.
# For production, set your actual deployment origin.
CAPTCHA_ALLOWED_ORIGIN=http://localhost:5173

# Allow localhost origins automatically during local development only.
ALLOW_LOCALHOST_ORIGINS=true

# Google reCAPTCHA secret key (server only).
# Never commit real secrets. Put the real value only in .env.server.local or Vercel env.
CAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# Node captcha verify server port
CAPTCHA_SERVER_PORT=8080

# Allowed frontend origin for CORS
# - Single: http://localhost:5173
# - Multiple: http://localhost:5173,http://localhost:5174
# - Wildcard (dev only): *
CAPTCHA_ALLOWED_ORIGIN=http://localhost:5173

# Allow localhost origins automatically when not listed in CAPTCHA_ALLOWED_ORIGIN
ALLOW_LOCALHOST_ORIGINS=true

# Google reCAPTCHA secret key (server only).
# Never commit real secrets to git. Put the real value only in .env.server.local.
CAPTCHA_SECRET_KEY=

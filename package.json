{
  "name": "quishing-client",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "security:check": "secretlint \"**/*\" && pnpm audit --audit-level high"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.6",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.0",
    "@tanstack/router-cli": "^1.166.2",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vanilla-extract/next-plugin": "^2.4.17",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "lefthook": "^1.13.6",
    "lint-staged": "^16.2.0",
    "prettier": "^3.8.1",
    "secretlint": "^11.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.166.3",
    "@vanilla-extract/css": "^1.18.0",
    "next": "^16.1.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
